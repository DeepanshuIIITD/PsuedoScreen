{
  "expo": {
    "name": "PsuedoScreen",
    "slug": "PsuedoScreen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/my_icon.png",
    "scheme": "psuedoscreen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deepanshualuria.psuedoscreen"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/my_adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.deepanshu_aluria.PsuedoScreen"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/my_splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5c75dcf-4cf9-44d3-a1db-44fe72f4ae5f"
      },
      "API_URL": "https://streak-app-production.up.railway.app"
    }
  }
}
